# TeamScape × Supabase — Environment Configuration
#
# TeamScape is a single HTML file. These values are pasted directly
# into TeamScape_V1.7.htm as JavaScript constants (search for
# SUPABASE_URL and SUPABASE_ANON_KEY near the top of the <script> block).
#
# This file is for reference only — it is not loaded by the browser.

# ── Supabase ───────────────────────────────────────────────────────────────
# Found at: supabase.com → Your Project → Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Anthropic (server-side only — stored as Supabase secret) ───────────────
# This key is NEVER put in the HTML file. It lives only in the scan-ppe
# Edge Function. Set it with:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# The Edge Function (supabase/functions/scan-ppe/index.ts) reads it via
# Deno.env.get('ANTHROPIC_API_KEY').

ANTHROPIC_API_KEY=sk-ant-...

# ── Demo User Accounts ────────────────────────────────────────────────────
# Create these in Supabase Auth dashboard (Authentication → Users → Invite user)
# or via CLI: supabase auth admin create-user ...
#
# After creating, set user metadata via:
#   Authentication → Users → click user → Edit → raw_user_meta_data
#
# at@demo.com      password: demo123   metadata: {"role":"at"}
# coach@demo.com   password: demo123   metadata: {"role":"coach"}
# sc@demo.com      password: demo123   metadata: {"role":"sc"}
# athlete@demo.com password: demo123   metadata: {"role":"athlete","athlete_key":"jsmith","athlete_name":"J. Smith","athlete_team":"Varsity Football"}
#
# The handle_new_user() trigger (defined in schema.sql) will automatically
# create the matching row in public.profiles on first sign-in.
